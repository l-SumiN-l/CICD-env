TZ=Asia/Tokyo

# Satisfactory Dedicated Server
# Image tag (latest, or a pinned version such as v1.9.11)
SATISFACTORY_IMAGE_TAG=latest
# Number of rotating autosave files to keep
SATISFACTORY_AUTOSAVENUM=5
PUID=1000
PGID=1000
STEAMBETA=false
SKIPUPDATE=false
SATISFACTORY_LOG=true
SATISFACTORY_MULTIHOME=0.0.0.0
SATISFACTORY_MAXPLAYERS=4
SATISFACTORY_GAME_PORT=7777
SATISFACTORY_MESSAGING_PORT=8888

# Discord Webhook URL for status notifications (secret: set it only in .env)
DISCORD_WEBHOOK_URL=

GAME_SERVER_NAME=CICD-ENV
